{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project Manifest",
  "description": "Stage 0 output: video metadata + normalized narration segments",
  "type": "object",
  "required": ["project_id", "video", "narration_segments"],
  "properties": {
    "project_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "video": {
      "type": "object",
      "required": ["path", "duration", "fps", "width", "height", "codec"],
      "properties": {
        "path": { "type": "string" },
        "duration": { "type": "number", "minimum": 0 },
        "fps": { "type": "number", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "codec": { "type": "string" },
        "bitrate": { "type": "string" },
        "duration_frames": { "type": "integer", "minimum": 0 }
      }
    },
    "narration": {
      "type": "object",
      "required": ["source_text", "total_chars", "total_segments"],
      "properties": {
        "source_file": { "type": "string" },
        "source_text": { "type": "string" },
        "total_chars": { "type": "integer" },
        "total_segments": { "type": "integer" }
      }
    },
    "narration_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "original_text", "tts_text", "char_count"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "original_text": { "type": "string" },
          "tts_text": { "type": "string" },
          "char_count": { "type": "integer", "minimum": 1 },
          "has_special_terms": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
